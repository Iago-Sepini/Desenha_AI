# Copie este arquivo para .env e preencha. O .env não vai para o git.

# Chave da Groq (obrigatória). Crie em https://console.groq.com/keys
GROQ_API_KEY=coloque_sua_chave_aqui

# Microfone do push-to-talk. Vazio = padrão do sistema.
# Aceita o índice (ex.: 14) ou parte do nome (ex.: QCY). O nome é mais
# estável, porque o índice muda quando se liga ou desliga um aparelho.
# Rode o programa e use /mics para ver a lista.
MIC_DEVICE=
